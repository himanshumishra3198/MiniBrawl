# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data (only ignore for deleted assets)
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db

# Builds / packaging
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Addressables
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Ss]erver[Dd]ata/

# Keystores - NEVER commit signing keys
*.keystore
*.jks
keystore.properties

# Unity Performance Testing package writes these during a test run
/[Aa]ssets/[Rr]esources/PerformanceTestRun*
